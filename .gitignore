# ═══════════════════════════════════════════════════════════════
# SecuraX .gitignore — Clean Research Repository
# Generated: 2026-07-30
# ═══════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────
venv/
env/
.venv/
backend/venv/
.env

# ── SQLite databases (runtime data — NEVER commit) ─────────────
# These may contain scan results, vulnerability data, credentials.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Secrets & credentials ──────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
# Explicit backend secrets — never commit these (SEC-01 remediation 2026-08-20)
backend/.env
backend/.env.*
!backend/.env.example

# ── Build artifacts ────────────────────────────────────────────
*.egg-info/
build/
dist/
*.egg
pip-wheel-metadata/
pip-log.txt

# ── Test artifacts ─────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── Linter/formatter caches ────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytype/

# ── Node / Frontend ────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.next/
*.node

# ── OS files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── IDE & Editor ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# ── Large data & binary files ──────────────────────────────────
*.tar.gz
*.zip
*.gz
nvd_data/
datasets/raw/

# ── Personal reports & generated documents (moved to _personal_archive) ─
_personal_archive/
*.pdf
HexaGuard_*.pdf
HexaGuard_*.md
HexaGuard_*.html
SecurAx_*.pdf
SecurAx_*.md
SecurAX_*.pdf
SecuraX_Project_Summary.*
*_Rapport_*.pdf
*_Rapport_*.md
*_500Pages*
*_Massive*
generate_*_report.py
generate_*_pdf.py
create_plan_pdf.py
push.bat

# ── HuggingFace push mirror ────────────────────────────────────
.hf_push/

# ── Research results (auto-generated — reproducible via Makefile) ──
# Uncomment to exclude results from git (keep for reproducibility now)
# results/

# ── Papers figures (auto-generated via generate_figures.py) ────
# papers/figures/*.png — kept for convenience

# ── Temporary scripts ──────────────────────────────────────────
bench_diag.py
diagnose_engine.py

# ── Migrations & compiled assets ───────────────────────────────
*.pyc

# ── Render / deployment artifacts ─────────────────────────────
.render-buildpacks.json
