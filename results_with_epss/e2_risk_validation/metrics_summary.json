          "fallback_observations": 14,
          "epss_calls": 9,
          "epss_hits": 8,
          "total_calls": 20,
          "epss_rate": 0.3,
          "fallback_rate": 0.7,
          "disclosure_label": "Baseline-EPSS (fallback-dominated)"
        },
        "disclosure": {
          "disclosure_label": "Baseline-EPSS (fallback-dominated)",
          "rule": "fallback_rate > 0.50 -> label as Baseline-EPSS (fallback-dominated). Such results must not be cited as a pure EPSS evaluation."
        },
